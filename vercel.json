{
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/media/(.*)",
            "destination": "/api/media/$1"
        },
        {
            "source": "/static/(.*)",
            "destination": "/api/static/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ]
}